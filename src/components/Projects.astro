---
// src/components/Projects.astro
const projects = [
  {
    title: "Mapping Arquitectónico",
    category: "Fachadas Monumentales",
    location: "Festivales Internacionales",
    image: "https://momapstudio.com/wp-content/uploads/2026/06/FOTO-2025.png",
    link: "https://momapstudio.com/proyectos-videomapping/arquitectonico",
    badge: "Gran Formato",
    featured: true,
  },
  {
    title: "Videomapping Inmersivo 360",
    category: "Experiencias Envolventes",
    location: "Espacios de Arte",
    image: "https://momapstudio.com/wp-content/uploads/2021/05/MOMAP-WEB.png",
    link: "https://momapstudio.com/proyectos-videomapping/videomapping-inversivo",
    badge: "360° Tech",
    featured: false,
  },
  {
    title: "Videomapping para Museos",
    category: "Patrimonio & Cultura",
    location: "Exposiciones",
    image: "https://momapstudio.com/wp-content/uploads/2026/06/FOTO-2025.png",
    link: "https://momapstudio.com/proyectos-videomapping/videomapping-museos",
    badge: "Divulgación",
    featured: false,
  },
  {
    title: "Eventos & Espectáculos",
    category: "Dirección de Arte & 3D",
    location: "Galas & Shows",
    image: "https://momapstudio.com/wp-content/uploads/2021/05/MOMAP-WEB.png",
    link: "https://momapstudio.com/proyectos-videomapping/para-eventos",
    badge: "En Vivo",
    featured: true,
  },
];
---

<section id="proyectos" class="relative bg-black text-white py-32 px-6 overflow-hidden">
  <!-- Luces ambientales de fondo -->
  <div class="absolute top-1/2 left-0 w-96 h-96 bg-amber-500/10 rounded-full blur-[150px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-0 w-96 h-96 bg-purple-600/10 rounded-full blur-[150px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10 space-y-16">
    
    <!-- Encabezado de la sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-800/80 pb-10">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-mono uppercase tracking-widest mb-4">
          PORTFOLIO SELECCIONADO
        </div>
        <h2 class="text-4xl md:text-6xl font-black tracking-tight uppercase">
          OBRAS & <span class="bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 bg-clip-text text-transparent">EXPERIENCIAS</span>
        </h2>
      </div>
      <p class="max-w-md text-slate-400 text-sm md:text-base font-light leading-relaxed">
        Proyecciones de alto impacto que transforman volúmenes arquitectónicos y espacios cerrados en espectáculos sensoriales.
      </p>
    </div>

    <!-- Grilla de Proyectos Estilo Galería Cinemática -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <a 
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class={`group relative rounded-3xl overflow-hidden border border-slate-800/80 bg-slate-950 transition-all duration-500 hover:border-amber-500/50 hover:shadow-[0_0_40px_rgba(245,158,11,0.2)] flex flex-col justify-end min-h-[420px] ${project.featured ? 'md:col-span-2 md:min-h-[500px]' : ''}`}
        >
          <!-- Imagen con efecto zoom al hacer hover -->
          <img 
            src={project.image} 
            alt={project.title}
            class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-75 group-hover:scale-105 transition-all duration-700 ease-out filter contrast-125"
          />
          
          <!-- Degradado de cine para oscurecer el fondo del texto -->
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

          <!-- Badge en la esquina superior -->
          <div class="absolute top-6 left-6 z-10">
            <span class="px-3 py-1 rounded-full bg-black/60 border border-white/10 backdrop-blur-md text-slate-300 text-xs font-mono tracking-wider">
              {project.badge}
            </span>
          </div>

          <!-- Contenido de la tarjeta -->
          <div class="relative z-10 p-8 space-y-3 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
            <span class="text-amber-400 text-xs font-mono tracking-widest uppercase font-semibold">
              {project.category} — {project.location}
            </span>
            <div class="flex items-center justify-between">
              <h3 class="text-2xl md:text-4xl font-extrabold tracking-tight group-hover:text-amber-300 transition-colors">
                {project.title}
              </h3>
              <!-- Flecha de apertura -->
              <div class="w-12 h-12 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-white group-hover:bg-amber-500 group-hover:text-black group-hover:border-amber-500 transition-all duration-300 transform group-hover:rotate-45">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-900 text-slate-400 py-12 px-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Logo e Identidad -->
    <div class="text-center md:text-left flex items-center gap-3">
      <img 
        src={import.meta.env.BASE_URL + '/favicon.webp'} 
        alt="MOMAP Studio Logo" 
        class="w-6 h-6 rounded"
      />
      <div>
        <span class="text-base font-bold text-white tracking-wider">MOMAP STUDIO</span>
        <p class="text-xs text-slate-500">Video Mapping & Arte Audiovisual</p>
      </div>
    </div>

    <!-- Navegación rápida -->
    <nav class="flex flex-wrap justify-center gap-6 text-sm font-medium">
      <a href={import.meta.env.BASE_URL + '/'} class="hover:text-white transition-colors">Inicio</a>
      <a href={import.meta.env.BASE_URL + '/proyectos'} class="hover:text-white transition-colors">Proyectos</a>
      <a href={import.meta.env.BASE_URL + '/servicios'} class="hover:text-white transition-colors">Servicios</a>
      <a href={import.meta.env.BASE_URL + '/sobre-nosotros'} class="hover:text-white transition-colors">Sobre Nosotros</a>
      <a href={import.meta.env.BASE_URL + '/contacto'} class="hover:text-white transition-colors">Contacto</a>
    </nav>

    <!-- Copyright -->
    <div class="text-xs text-slate-600 text-center md:text-right">
      &copy; {currentYear} MOMAP Studio. Todos los derechos reservados.
    </div>

  </div>
</footer>
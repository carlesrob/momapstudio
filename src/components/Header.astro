---
// src/components/Header.astro
---

<header class="fixed top-0 left-0 w-full z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    
    <!-- Logotipo oficial horizontal -->
    <a href={import.meta.env.BASE_URL + '/'} class="flex items-center group py-2">
      <img 
        src={import.meta.env.BASE_URL + '/logo_header_60h.png'} 
        alt="MOMAP Studio logo" 
        class="h-10 w-auto object-contain group-hover:scale-105 transition-transform"
      />
    </a>

    <!-- Menú de navegación principal -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-200">
      
      <!-- Dropdown Servicios -->
      <div class="relative group py-4">
        <a href={import.meta.env.BASE_URL + '/servicios'} class="flex items-center gap-1 hover:text-amber-400 transition-colors uppercase tracking-wider text-xs font-semibold">
          Servicios
          <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-transform group-hover:rotate-180" fill="currentColor" viewBox="0 0 320 512"><path d="M143.274 353.161L14.73 224.617c-9.373-9.373-9.373-24.569 0-33.941l22.627-22.627c9.373-9.373 24.569-9.373 33.941 0L160 255.274l88.682-88.685c9.373-9.373 24.569-9.373 33.941 0l22.627 22.627c9.373 9.373 9.373 24.569 0 33.941L176.726 353.161c-9.373 9.373-24.569 9.373-33.952 0z"/></svg>
        </a>
        
        <!-- Submenú desplegable -->
        <div class="absolute top-full left-0 w-64 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0">
          <a href={import.meta.env.BASE_URL + '/servicios'} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-amber-500/10 hover:text-amber-400 transition-colors">Videomapping Arquitectónico</a>
          <a href={import.meta.env.BASE_URL + '/servicios'} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-amber-500/10 hover:text-amber-400 transition-colors">Videomapping de Interior</a>
          <a href={import.meta.env.BASE_URL + '/servicios'} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-amber-500/10 hover:text-amber-400 transition-colors">Videomapping para Eventos</a>
          <a href={import.meta.env.BASE_URL + '/servicios'} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-amber-500/10 hover:text-amber-400 transition-colors">Videomapping Inmersivo 360</a>
          <a href={import.meta.env.BASE_URL + '/servicios'} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-amber-500/10 hover:text-amber-400 transition-colors">Videomapping Museos</a>
          <a href={import.meta.env.BASE_URL + '/servicios'} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-amber-500/10 hover:text-amber-400 transition-colors">Videomapping Navideño</a>
        </div>
      </div>

      <!-- Enlace Proyectos -->
      <a href={import.meta.env.BASE_URL + '/proyectos'} class="hover:text-amber-400 transition-colors uppercase tracking-wider text-xs font-semibold">
        Proyectos
      </a>

      <!-- Enlace Chema Siscar -->
      <a href={import.meta.env.BASE_URL + '/sobre-nosotros'} class="hover:text-amber-400 transition-colors uppercase tracking-wider text-xs font-semibold">
        Chema Siscar
      </a>

      <!-- YouTube -->
      <a href="https://www.youtube.com/channel/UCJp_yNWslItpuIjHzHO_T7A" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors uppercase tracking-wider text-xs font-semibold flex items-center gap-1.5">
        <svg class="w-4 h-4 fill-current text-red-500" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        YouTube
      </a>
    </nav>

    <!-- Botón de Contacto CTA -->
    <div>
      <a 
        href={import.meta.env.BASE_URL + '/#contacto'} 
        class="px-5 py-2.5 rounded-xl bg-red-600/20 border border-red-500/40 text-red-300 font-semibold text-xs uppercase tracking-wider hover:bg-red-600 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(231,51,58,0.2)]"
      >
        Contacto
      </a>
    </div>

  </div>
</header>
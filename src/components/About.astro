---
// src/components/About.astro
const awards = [
  { year: "1.er / 2.º", title: "Luz y Vanguardias", detail: "Premios Oficiales" },
  { year: "Bolshoi", title: "Teatro Bolshói", detail: "Moscú · Rusia" },
  { year: "+60", title: "Proyectos Globales", detail: "Festivales y Museos" },
];
---

<section id="estudio" class="relative bg-slate-950 text-white py-32 px-6 overflow-hidden border-t border-slate-900">
  <!-- Glows ambientales -->
  <div class="absolute top-1/3 right-10 w-96 h-96 bg-purple-600/10 rounded-full blur-[160px] pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-amber-500/10 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Columna Izquierda: Retrato / Visual del Artista -->
    <div class="lg:col-span-5 relative">
      <div class="relative rounded-3xl overflow-hidden border border-slate-800 bg-slate-900 shadow-[0_0_50px_rgba(0,0,0,0.8)] group">
        <img 
          src="https://momapstudio.com/wp-content/uploads/2026/06/FOTO-2025.png" 
          alt="Chema Siscar - MOMAP Studio" 
          class="w-full h-[520px] object-cover object-top opacity-85 group-hover:scale-105 transition-transform duration-700 filter contrast-110"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
        
        <div class="absolute bottom-6 left-6 right-6 p-6 rounded-2xl bg-slate-900/90 border border-slate-800/80 backdrop-blur-md">
          <span class="text-amber-400 font-mono text-xs uppercase tracking-widest block mb-1">Audiovisual Artist · Director · Founder</span>
          <h3 class="text-2xl font-bold text-white">Chema Siscar</h3>
          <p class="text-slate-400 text-xs mt-1">Investigación en la confluencia entre arquitectura, iluminación espectral y narrativa emocional.</p>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Manifiesto y Trayectoria -->
    <div class="lg:col-span-7 space-y-8">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-mono uppercase tracking-widest">
          ARQUITECTURA EFÍMERA & NARRATIVA DE LUZ
        </div>
        <h2 class="text-3xl md:text-5xl font-black tracking-tight uppercase leading-tight">
          Transformamos la piedra en <br />
          <span class="bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 bg-clip-text text-transparent">
            lienzo digital vivo
          </span>
        </h2>
      </div>

      <p class="text-slate-300 text-base md:text-lg leading-relaxed font-light">
        En <strong class="text-white font-semibold">MOMAP Studio</strong> concebimos el videomapping no solo como un despliegue técnico de proyectores de alta potencia, sino como un lenguaje artístico capaz de alterar la percepción del espacio y conectar con miles de espectadores.
      </p>

      <!-- Hitos en formato etiquetas/badges de prestigio -->
      <div class="flex flex-wrap gap-2 text-xs font-mono pt-2">
        <span class="px-3 py-1 bg-slate-900/80 border border-slate-800 text-slate-300 rounded-full">Teatro Bolshói · Moscú</span>
        <span class="px-3 py-1 bg-slate-900/80 border border-slate-800 text-slate-300 rounded-full">Palacio de Charlottenburg · Berlín</span>
        <span class="px-3 py-1 bg-slate-900/80 border border-slate-800 text-slate-300 rounded-full">Cristo Redentor · Río de Janeiro</span>
        <span class="px-3 py-1 bg-slate-900/80 border border-slate-800 text-slate-300 rounded-full">Epson Mapping Challenge</span>
        <span class="px-3 py-1 bg-slate-900/80 border border-slate-800 text-slate-300 rounded-full">Haro Festival de Luz 2026</span>
      </div>

      <!-- Grid de Galardones y Métricas -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
        {awards.map((item) => (
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-sm">
            <div class="text-xl font-black text-amber-400 tracking-tight">{item.year}</div>
            <div class="text-sm font-semibold text-white mt-1">{item.title}</div>
            <div class="text-xs text-slate-400 mt-0.5">{item.detail}</div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
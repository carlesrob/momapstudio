---
// src/components/Contact.astro
---

<section id="contacto" class="relative bg-black text-white py-32 px-6 overflow-hidden border-t border-slate-900">
  <!-- Glows ambientales -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-amber-500/10 rounded-full blur-[180px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto relative z-10 text-center space-y-12">
    
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-mono uppercase tracking-widest">
        CONTRATACIÓN & FESTIVALES
      </div>
      <h2 class="text-4xl md:text-6xl font-black tracking-tight uppercase">
        ¿Tienes un proyecto <br />
        <span class="bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 bg-clip-text text-transparent">
          en mente?
        </span>
      </h2>
      <p class="max-w-xl mx-auto text-slate-300 text-base md:text-lg font-light">
        Diseñamos experiencias lumínicas y proyecciones arquitectónicas a medida para instituciones, festivales y marcas internacionales.
      </p>
    </div>

    <!-- Formulario Cinemático -->
    <form class="bg-slate-950/80 border border-slate-800 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-xl text-left space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="nombre" class="block text-xs font-mono uppercase text-slate-400 mb-2">Nombre / Organización</label>
          <input 
            type="text" 
            id="nombre" 
            placeholder="Tu nombre o entidad"
            class="w-full px-4 py-3.5 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-colors text-sm"
          />
        </div>
        <div>
          <label for="email" class="block text-xs font-mono uppercase text-slate-400 mb-2">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            placeholder="correo@ejemplo.com"
            class="w-full px-4 py-3.5 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-colors text-sm"
          />
        </div>
      </div>

      <div>
        <label for="mensaje" class="block text-xs font-mono uppercase text-slate-400 mb-2">Detalles del Proyecto</label>
        <textarea 
          id="mensaje" 
          rows="4" 
          placeholder="Cuéntanos sobre el monumento, edificio, fechas estimadas o tipología de evento..."
          class="w-full px-4 py-3.5 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-colors text-sm"
        ></textarea>
      </div>

      <button 
        type="submit"
        class="w-full py-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 font-bold uppercase tracking-widest text-sm hover:shadow-[0_0_30px_rgba(245,158,11,0.5)] transition-all duration-300 cursor-pointer"
      >
        Solicitar Propuesta
      </button>
    </form>

    <!-- Footer sencillo y redes -->
    <div class="pt-12 border-t border-slate-900 text-slate-500 text-xs font-mono flex flex-col sm:flex-row justify-between items-center gap-4">
      <span>© 2026 MOMAP Studio. Todos los derechos reservados.</span>
      <div class="flex gap-6 text-slate-400">
        <a href="https://www.instagram.com/momapstudio_/" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors">Instagram</a>
        <a href="https://www.youtube.com/channel/UCJp_yNWslItpuIjHzHO_T7A" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors">YouTube</a>
        <a href="https://www.facebook.com/momapstudio" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors">Facebook</a>
      </div>
    </div>

  </div>
</section>